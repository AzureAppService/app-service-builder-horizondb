# These are non-secret settings. Attach the user-assigned managed identity to
# the running app separately; a client ID alone does not attach an identity.
HORIZONDB_HOST=
HORIZONDB_DATABASE=fieldguides
HORIZONDB_USER=
AZURE_CLIENT_ID=
# Set the HorizonDB-supported Entra scope after verifying it for your cluster.
HORIZONDB_TOKEN_SCOPE=

# Only the separately run database bootstrap uses these values.
HORIZONDB_ADMIN_USER=
HORIZONDB_RUNTIME_ROLE=
HORIZONDB_CONFIRM_DATABASE=
